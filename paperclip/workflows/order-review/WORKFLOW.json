{
  "apiVersion": "abs.fenixalliance.com/v1alpha1",
  "key": "fenixalliance.flows.order-review",
  "name": "Order Review",
  "version": "1.0.0",
  "description": "Reviews one sales order across bounded Commerce surfaces: reads the tenant-owned order, lists its order lines, and for each line looks up the referenced product through the published-only public catalog. Read-only (no mutation, no approval), driven by an orderId run input. Every product lookup is derived from an authorized order line's ItemId, not a caller-supplied id; the catalog read is Published-only. The per-line product lookup is demonstrative of Commerce composition across bounded surfaces, not mandatory business behavior (the line already carries item summary fields).",
  "requires": {
    "capabilities": [
      "abs.orders.get_order",
      "abs.orders.list_order_lines",
      "abs.catalog.get_public_product"
    ]
  },
  "definition": {
    "nodes": [
      { "id": "start", "type": "Start", "position": { "x": 0, "y": 160 } },
      {
        "id": "order",
        "type": "ServiceQuery",
        "position": { "x": 240, "y": 160 },
        "config": {
          "capabilityKey": "abs.orders.get_order",
          "input": {
            "TenantId": "{{workflow.tenantId}}",
            "ActorUserId": "{{workflow.actorUserId}}",
            "OrderId": "{{input.orderId}}"
          },
          "outputVar": "order"
        }
      },
      {
        "id": "lines",
        "type": "ServiceQuery",
        "position": { "x": 480, "y": 160 },
        "config": {
          "capabilityKey": "abs.orders.list_order_lines",
          "input": {
            "TenantId": "{{workflow.tenantId}}",
            "ActorUserId": "{{workflow.actorUserId}}",
            "OrderId": "{{steps.order.Id}}"
          },
          "outputVar": "lines"
        }
      },
      {
        "id": "forEachLine",
        "type": "ForEach",
        "position": { "x": 720, "y": 160 },
        "config": {
          "collection": { "source": "token", "value": "{{steps.lines}}" },
          "maxIterations": 100
        }
      },
      {
        "id": "product",
        "type": "ServiceQuery",
        "position": { "x": 720, "y": 340 },
        "config": {
          "capabilityKey": "abs.catalog.get_public_product",
          "input": {
            "TenantId": "{{workflow.tenantId}}",
            "ActorUserId": "{{workflow.actorUserId}}",
            "ItemId": "{{loop.item.ItemId}}"
          },
          "outputVar": "product"
        }
      },
      { "id": "end", "type": "End", "position": { "x": 960, "y": 160 } }
    ],
    "edges": [
      { "id": "e1", "sourceNodeId": "start", "targetNodeId": "order" },
      { "id": "e2", "sourceNodeId": "order", "targetNodeId": "lines" },
      { "id": "e3", "sourceNodeId": "lines", "targetNodeId": "forEachLine" },
      { "id": "e4", "sourceNodeId": "forEachLine", "targetNodeId": "product", "sourceHandle": "body" },
      { "id": "e5", "sourceNodeId": "forEachLine", "targetNodeId": "end", "sourceHandle": "done" }
    ],
    "variables": {}
  }
}
